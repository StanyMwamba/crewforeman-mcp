#!/bin/sh
# CrewForeman pre-push gate (checked-in copy; the connector auto-installs the
# same gate in repositories where it creates commits or rebases).
#
# Install by hand with:
#     git config core.hooksPath scripts/hooks
#
# It scans the commit METADATA (author and committer name+email, plus message
# and trailer addresses) and the added file content of every pushed commit,
# and blocks the push when anything is outside the allowlist (configured
# `git_identity` plus `noreply@example.com`).  Exceptions are exact
# `owner/repo` or URL matches; bare remote names are ignored.
#
# An operator hook in the same directory is preserved as pre-push.local and
# runs first.
zero="0000000000000000000000000000000000000000"
HOOK_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
ROOT=$(CDPATH='' cd -- "$HOOK_DIR/../.." && pwd -P) || exit 1
refs="$HOOK_DIR/.pre-push-refs.$$"
trap 'rm -f "$refs"' EXIT HUP INT TERM
cat > "$refs" || exit 1
status=0
if [ -x "$HOOK_DIR/pre-push.local" ]; then
    "$HOOK_DIR/pre-push.local" "$@" < "$refs" || status=1
fi
PYTHON="${CF_PYTHON:-}"
if [ -z "$PYTHON" ]; then
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi
if [ -z "$PYTHON" ]; then
    echo "pre-push: no python interpreter found; refusing." >&2
    exit 1
fi
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) CF_SEP=';' ;;
    *) CF_SEP=':' ;;
esac
CF_PYTHONPATH="$ROOT"
if [ -n "${PYTHONPATH:-}" ]; then
    CF_PYTHONPATH="$CF_PYTHONPATH$CF_SEP$PYTHONPATH"
fi
export PYTHONPATH="$CF_PYTHONPATH"
remote="$1"
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    base="$remote_sha"
    case "$base" in
        "$zero"|"") base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base="" ;;
    esac
    # An empty base scans the full pushed history (new branch, no origin/main).
    if ! "$PYTHON" -m deepseek_mcp.git_identity \
            --repo . --base "$base" --head "$local_sha" --remote "$remote"; then
        status=1
    fi
done < "$refs"
if [ "$status" -ne 0 ]; then
    echo "pre-push: blocked by the CrewForeman privacy/identity gate." >&2
fi
exit "$status"
